  "cards": [
    {
      "dot": "emerald",
      "title": "SEO",
      "items": [
        "Every sitemap URL is pre-rendered to real HTML on deploy",
        "Link previews and AI crawlers read each page's own title, image and text",
        "Unknown URLs fall back to spa.html and render in the browser"
      ]
    },
    {
      "dot": "cyan",
      "title": "Speed on phones",
      "items": [
        "Phones get a 19 KB poster instead of the ~2.2 MB Spline 3D scene",
        "The public site ships only Supabase's query client (postgrest-js)",
        "Desktop loads the 3D scene after the page has finished loading"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Browsers hold only the publishable key; the secret key lives on Render",
        "RLS: anyone reads content and approved reviews; only admins write",
        "Forms and chat are validated and rate-limited; chat has a daily cap and stores no transcripts"
      ]
    }
  ]
