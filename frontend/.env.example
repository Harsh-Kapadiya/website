# All optional — the site runs fine with these unset, using built-in
# default content and simulated form behavior. Fill in when ready:

# Supabase — for live content (projects, testimonials, page copy).
# Anon key only, protected by Row Level Security. Never put the service
# role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Your backend's URL — powers the Contact and Feedback forms.
# Local dev: http://localhost:8787
# Production: wherever you deploy backend/ (Railway, Render, Fly...)
VITE_API_URL=
