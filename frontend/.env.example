# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Safe in the browser: Row Level Security protects the data.
# (The legacy name VITE_SUPABASE_PUBLISHABLE_KEY is also accepted.)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Your Render backend URL — powers the contact + feedback forms. No trailing slash.
VITE_API_URL=http://localhost:8787

# Your public site URL — used for canonical links, sitemap.xml, robots.txt
# and social share previews. No trailing slash.
VITE_SITE_URL=https://website-ten-dun-87.vercel.app

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=
