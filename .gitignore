@"
# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Production builds
dist/
build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Supabase local/project secrets
supabase/.temp/
supabase/.branches/
supabase/.gitignore

# Database / SQL
supabase/schema.sql
supabase/*.sql
*.sql

# Local database dumps
*.dump
*.backup
*.bak

# Certificates / private keys
*.pem
*.key
*.crt

# Runtime files
*.pid

# Coverage
coverage/

# Temporary files
tmp/
temp/

# Personal/local files
.local/
"@ | Set-Content .gitignore