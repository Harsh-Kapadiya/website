PORT=8787

# Supabase — service role key ONLY lives here, never in frontend/admin-panel.
# Find both under Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of every origin allowed to call this API.
# Add your real deployed URLs here once frontend/admin-panel are hosted.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Where contact-form and feedback-form notifications get sent.
OWNER_EMAIL=you@example.com

# SMTP — used to actually send those notification emails.
# Gmail example (needs a 16-character App Password, not your normal
# password: Google Account > Security > 2-Step Verification > App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
# Any other SMTP provider (Resend, SendGrid, Outlook, Zoho...) works the
# same way — just swap in their host/port/credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
