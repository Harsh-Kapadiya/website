# Local dev only — on Render, set these in the dashboard's Environment tab.
NODE_ENV=development
PORT=8787

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...).
# Legacy name SUPABASE_SERVICE_ROLE_KEY also works. NEVER put this in
# frontend/ or admin-panel/ — it bypasses Row Level Security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Every browser origin allowed to call this API, comma-separated.
# REQUIRED in production — the server refuses to start without it.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Where contact + feedback notifications are sent.
OWNER_EMAIL=you@example.com

# Email. On Render's free tier SMTP is blocked — set RESEND_API_KEY instead
# (resend.com, sign up with OWNER_EMAIL). When it's set, SMTP is ignored.
RESEND_API_KEY=

# SMTP (local dev or paid Render; Gmail: smtp.gmail.com / 587 / 16-char App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM=you@gmail.com

# Website chat assistant (optional). Without a key the chat shows "offline".
# Google AI Studio (aistudio.google.com) → Get API key. Keep billing OFF to stay on the free tier.
GEMINI_API_KEY=
# Hard cap on assistant replies per day across all visitors.
CHAT_DAILY_LIMIT=300
# Optional model overrides (defaults shown).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
